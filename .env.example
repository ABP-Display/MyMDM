MYMDM_BASE_URL=http://localhost:8380/

APP_NAME=MyMDM
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=${MYMDM_BASE_URL}

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mymdm
DB_USERNAME=mymdm
DB_PASSWORD=mymdm
SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync

MYMDM_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
MYMDM_BOOTSTRAP_ADMIN_PASSWORD=change-me-change-me

# Docker mounts android/app/build/outputs/apk/debug automatically.
MYMDM_AGENT_VERSION=0.2.0-dev
MYMDM_AGENT_VERSION_CODE=8
MYMDM_ENROLLMENT_TTL_HOURS=24

# Name used for the initial organization; customize it later in Settings.
MYMDM_ORGANIZATION_NAME="Default"
